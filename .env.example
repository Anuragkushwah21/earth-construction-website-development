# ---------------------------------------------------------------------------
# Earth Construction Company — environment configuration
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored: never commit real secrets.
# ---------------------------------------------------------------------------

# MongoDB connection string (required).
# Local:  mongodb://127.0.0.1:27017/earth-construction
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/earth-construction
MONGODB_URI=

# Secret used to sign the admin session cookie (required).
# Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# First admin account. Created automatically on the first login attempt if the
# admin collection is empty. Once signed in, change the password from
# Settings -> Change password rather than by editing these values.
ADMIN_EMAIL=admin@earthconstruction.com
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Extra admin accounts, created by `pnpm seed:admins` with ADMIN_PASSWORD as
# their initial password. Comma-separated; an optional display name follows a
# pipe. Accounts that already exist are never modified, so re-running is safe.
ADMIN_EMAILS="first@example.com|First Admin,second@example.com|Second Admin"

# Public site URL, used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Image storage (optional).
# Leave these blank to store uploads on the local disk under public/uploads —
# fine for development, but not for serverless hosting such as Vercel, where
# the filesystem is not persistent. Set all three to use Cloudinary instead.
# ---------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Password-reset email over Gmail SMTP (optional).
# Leave blank to disable: the "Forgot password" form still answers normally,
# but no mail is sent and the reset link is only printed to the server log in
# development.
#
# SMTP_PASS must be a Google App Password (16 characters), not the account
# password. Create one at https://myaccount.google.com/apppasswords with
# 2-Step Verification switched on.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to "Earth Construction Company <SMTP_USER>".
SMTP_FROM=
